<Project>
  <PropertyGroup>
    <Version>0.3.0</Version>
    <Authors>TouchKeyboard contributors</Authors>
    <Copyright>Copyright (c) 2026 TouchKeyboard contributors</Copyright>
    <Product>TouchKeyboard</Product>
    <RepositoryUrl>https://github.com/Yubickari/TouchKeyboard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Yubickari/TouchKeyboard</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>avalonia;touch;keyboard;virtual-keyboard;kiosk;industrial;netstandard</PackageTags>
    <Description>Touch-first embedded keyboard for Avalonia, built for small industrial touch screens.</Description>

    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EnablePackageValidation>true</EnablePackageValidation>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
